# Copy to .sonogym.env and adjust only after verifying the paths on HiPerGator.
SONOGYM_PROJECT_DIR=/blue/anest-dept/vinhnguyen1/cssalt-sonogym
SONOGYM_RUNTIME_DIR=/blue/anest-dept/vinhnguyen1/cssalt-sonogym-runtime
SONOGYM_ENV_PREFIX=/blue/anest-dept/vinhnguyen1/cssalt-sonogym-runtime/envs/sonogym
SONOGYM_ASSETS_DATA_DIR=/blue/anest-dept/vinhnguyen1/cssalt-sonogym-runtime/assets/data
SONOGYM_MODELS_DIR=/blue/anest-dept/vinhnguyen1/cssalt-sonogym-runtime/models
SONOGYM_OUTPUT_DIR=/blue/anest-dept/vinhnguyen1/cssalt-sonogym-runtime/outputs
SONOGYM_CACHE_DIR=/blue/anest-dept/vinhnguyen1/cssalt-sonogym-runtime/cache
SONOGYM_GUIDANCE_CONFIG=/blue/anest-dept/vinhnguyen1/cssalt-sonogym/config/guidance_baseline.yaml
SONOGYM_WANDB_MODE=disabled
# Change to Y only after the account holder accepts the NVIDIA Omniverse EULA.
OMNI_KIT_ACCEPT_EULA=N

SLURM_ACCOUNT=anest-dept
SLURM_PARTITION=hpg-turin
SLURM_CPUS=4
SLURM_GPUS=1
SLURM_MEMORY=30G
SMOKE_WALLTIME=00:30:00
PPO_WALLTIME=01:30:00
EVAL_WALLTIME=00:30:00
DEMO_WALLTIME=00:15:00
# Machine-local path to an approved checkpoint; do not commit the checkpoint itself.
SONOGYM_EVAL_CHECKPOINT=/blue/anest-dept/vinhnguyen1/cssalt-sonogym-runtime/outputs/ppo/JOB_ID/logs/RUN/checkpoints/agent.pt
